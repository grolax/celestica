# Copiar este archivo a .env y completar
ANTHROPIC_API_KEY=sk-ant-...
# Modelo a usar para análisis temático
CLAUDE_MODEL=claude-sonnet-4-6
# Modelo para el informe multi-prompt V2 (opcional; default: CLAUDE_MODEL)
# CLAUDE_MODEL_REPORT_V2=claude-sonnet-4-6
# Workers paralelos para el análisis por respondente del informe V2 (default: 6)
# REPORT_V2_MAX_WORKERS=6
# --- Informe V2: presupuestos de tokens (ver services/thematic.py) ---
# Tokens de ENTRADA máximos por tanda de síntesis de clusters (default 10000 ≈ 14 respondentes).
# SYNTHESIS_BATCH_INPUT_TOKENS=10000
# Tokens de entrada máximos por llamada de fusión/selección de citas (default 16000)
# MERGE_INPUT_TOKENS=16000
# Techo de salida por llamada de síntesis/fusión/informe (default 32000; se acota al límite real del modelo)
# CLAUDE_LARGE_OUTPUT_TOKENS=32000
# Límite de salida del modelo. Si no se define, se consulta a la API una vez (sonda sin costo).
# CLAUDE_MAX_OUTPUT_TOKENS=128000
# --- Registro y costo de llamadas a Claude (ver services/claude_log.py) ---
# Carpeta de logs (default: backend/logs) — claude_calls.jsonl, softinsight.log, claude_raw/
# CLAUDE_LOG_DIR=logs
# 1 = guardar el texto crudo de TODAS las llamadas (no solo las fallidas); ocupa disco
# CLAUDE_LOG_RAW=0
# Precios USD por millón de tokens [entrada, salida], por prefijo de modelo (estimación de costo)
# CLAUDE_PRICING_JSON={"claude-sonnet-4": [3, 15]}
# Firma de tokens JWT — usar un valor aleatorio largo en producción
# (también deriva la clave de cifrado de credenciales de integraciones)
SECRET_KEY=cambiar-por-valor-aleatorio-largo
# Conexión a MongoDB (default: local; para Atlas basta cambiar esta URI)
# MONGODB_URI=mongodb://localhost:27017/softinsight
# MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/softinsight
# Contraseña del panel interno de prompts metodológicos
ADMIN_PASSWORD=softinsight2026
