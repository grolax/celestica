# Copiar este archivo a .env y completar
ANTHROPIC_API_KEY=sk-ant-...
# Modelo a usar para análisis temático
CLAUDE_MODEL=claude-sonnet-4-6
# Firma de tokens JWT — usar un valor aleatorio largo en producción
# (también deriva la clave de cifrado de credenciales de integraciones)
SECRET_KEY=cambiar-por-valor-aleatorio-largo
# Conexión a MongoDB (default: local; para Atlas basta cambiar esta URI)
# MONGODB_URI=mongodb://localhost:27017/softinsight
# MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/softinsight
# Contraseña del panel interno de prompts metodológicos
ADMIN_PASSWORD=softinsight2026
